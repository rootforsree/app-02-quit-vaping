<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup + device-transfer rules. Once any <include> is declared the
  rules become an allow-list per domain, so both the Room database and the
  quit preferences must be listed or settings will not survive a restore.
  Backup is free and never paywalled.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="quit_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
